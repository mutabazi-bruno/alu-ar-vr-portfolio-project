  m_Name: Note2
  m_EditorClassIdentifier: HeyHeyThere.EscapePuzzleKitFree::HeyHeyThere.EscapePuzzleKitFree.Item
  id: note_2
  title: "Note from the locker"
  description: "A note from the caretaker's locker."
  icon: {fileID: 21300000, guid: 3189e4a0e0a7eb91a1d729df07a2ffeb, type: 3}
  kind: 3
  amount: 0
  text: "The safe remembers four years of my life.\n\nFirst, the year I walked through these doors. It's on my badge. Then the box that looks like a full moon. Then the one with four equal sides. Last, the one shaped like a roof.\n\nTake the last digit of each year.\n\nP.S. I never remember which hook. So I scratched it on the back of my badge."
  keep: 0
  model: {fileID: 542072996525601727, guid: 66fb9b6cbbe53c2ea33a75739ba24934, type: 3}
